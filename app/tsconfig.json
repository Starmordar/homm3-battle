{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "strictPropertyInitialization": false,
    "paths": {
      "@/*": ["./src/*"],
    }
  },
  "include": ["src"]
}
